[["show_demo", {"title": "Opening a commit: what Repo.Diff runs", "summary": "The real call tree under `Repo.Diff`, built from CodeDiver's call graph. Follow what happens when you click the *first* commit of a repository in History (the bug fixed in #30).", "seed": {"symbol": "Repo.Diff", "depth": 2}, "steps": [{"title": "History asks for one commit", "focus": ["Repo.Diff"], "values": {"Repo.Diff": "Commit: 28f5ef3"}, "code": {"file": "internal/gitx/git.go", "line": 180, "end_line": 191}, "narration": "The UI now sends `{commit}` instead of building `28f5ef3~1` itself, so the backend decides what to compare against."}, {"title": "Resolve the commit's parent", "focus": ["CommitRange"], "values": {"CommitRange": "parent? none (root)"}, "code": {"file": "internal/gitx/git.go", "line": 272, "end_line": 291}, "narration": "`git rev-parse <commit>^1` fails for a root commit. That's what used to surface as *unknown revision* (exit status 128)."}, {"title": "Fall back to the empty tree", "focus": ["CommitRange"], "values": {"CommitRange": "base = 4b825dc (empty tree)", "Repo.Diff": "Base=empty Head=28f5ef3"}, "narration": "Comparing with git's empty tree means everything in the commit shows as **added**, which is exactly what a first commit did."}, {"title": "Refs are validated", "focus": ["validRef"], "values": {"validRef": "ok"}, "narration": "Refs starting with `-` are refused so they can't be smuggled into git as options."}, {"title": "Run git diff and parse it", "focus": ["Repo.run", "ParseUnifiedDiff"], "values": {"Repo.run": "git diff 4b825dc 28f5ef3", "ParseUnifiedDiff": "3 files, +34 \u22120"}, "code": {"file": "internal/gitx/diff.go", "line": 108, "end_line": 112}}, {"title": "Back in the History view", "focus": ["Repo.Diff"], "values": {"Repo.Diff": "3 files added"}, "narration": "The diff view shows the commit's files as added. No more error."}]}], ["show_animation", {"title": "Why the event bus never blocks", "caption": "`Bus.Publish` gives each subscriber a small buffer. When a slow client's buffer is full, new events for **that** client are dropped, so one stuck subscriber can't freeze the app or the agent (see `internal/events/bus.go`).", "source": "<!doctype html><html><head><style>\nbody{display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px}\nsvg{width:min(860px,96vw);height:auto}\n.box{fill:var(--bg-2);stroke:var(--border-strong);stroke-width:1.2}\n.lbl{fill:var(--text);font:600 13px var(--font-ui)}\n.sub{fill:var(--text-3);font:11px var(--font-mono)}\n.slot{fill:var(--bg-3);stroke:var(--border)}\n.slot.full{fill:var(--accent)}\n.drop{fill:var(--err);font:600 11px var(--font-mono)}\nbutton{background:var(--bg-2);color:var(--text);border:1px solid var(--border-strong);border-radius:8px;padding:6px 14px;font:13px var(--font-ui);cursor:pointer}\n.row{display:flex;gap:8px;align-items:center;color:var(--text-2);font:12px var(--font-ui)}\n</style></head><body>\n<svg id=\"s\" viewBox=\"0 0 860 330\"></svg>\n<div class=\"row\"><button id=\"b\">Pause</button><span id=\"t\">Publisher sends events; each subscriber has a 4-slot buffer. A slow subscriber's buffer fills, and new events are dropped instead of blocking everyone.</span></div>\n<script>\nconst NS='http://www.w3.org/2000/svg',svg=document.getElementById('s');\nconst el=(n,a,p=svg)=>{const e=document.createElementNS(NS,n);for(const k in a)e.setAttribute(k,a[k]);p.appendChild(e);return e};\nel('rect',{x:30,y:135,width:150,height:60,rx:10,class:'box'});\nel('text',{x:48,y:160,class:'lbl'}).textContent='Bus.Publish';\nel('text',{x:48,y:180,class:'sub'}).textContent='never blocks';\nconst subs=[{name:'Desktop UI',rate:1},{name:'Browser UI',rate:.7},{name:'Slow client',rate:.12}].map((s,i)=>{\n const y=40+i*110;\n el('line',{x1:180,y1:165,x2:520,y2:y+30,stroke:'var(--border-strong)','stroke-width':1.5});\n el('rect',{x:520,y,width:300,height:60,rx:10,class:'box'});\n el('text',{x:536,y:y+22,class:'lbl'}).textContent=s.name;\n const slots=[0,1,2,3].map(j=>el('rect',{x:536+j*26,y:y+32,width:20,height:16,rx:3,class:'slot'}));\n const drops=el('text',{x:660,y:y+45,class:'drop'});\n return {...s,y,slots,buf:0,dropped:0,drops};\n});\nlet running=true,t=0;\ndocument.getElementById('b').onclick=e=>{running=!running;e.target.textContent=running?'Pause':'Play'};\nfunction send(){\n for(const s of subs){\n  const dot=el('circle',{cx:180,cy:165,r:6,fill:'var(--accent)'});\n  const t0=performance.now();\n  const step=now=>{const k=Math.min(1,(now-t0)/700);dot.setAttribute('cx',180+(340*k));dot.setAttribute('cy',165+(s.y+30-165)*k);\n   if(k<1)return requestAnimationFrame(step);\n   dot.remove();\n   if(s.buf<4){s.buf++}else{s.dropped++;s.drops.textContent='dropped '+s.dropped}\n   s.slots.forEach((r,j)=>r.setAttribute('class','slot'+(j<s.buf?' full':'')));\n  };requestAnimationFrame(step);\n }\n}\nsetInterval(()=>{if(!running)return;t++;if(t%2===0)send();\n for(const s of subs){if(Math.random()<s.rate&&s.buf>0){s.buf--;s.slots.forEach((r,j)=>r.setAttribute('class','slot'+(j<s.buf?' full':'')))}}\n},400);\n</script></body></html>"}]]
