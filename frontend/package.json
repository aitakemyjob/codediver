{
  "name": "codediver-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/gen-monaco.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.17",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
